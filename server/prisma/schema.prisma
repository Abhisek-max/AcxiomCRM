generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  Admin
  Manager
  SalesExecutive
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  PROSPECT
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

enum OpportunityStage {
  PROSPECTING
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum FollowUpType {
  CALL
  EMAIL
  MEETING
  TASK
}

enum FollowUpStatus {
  PLANNED
  COMPLETED
  CANCELLED
  MISSED
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  TASK
}

enum ActivityStatus {
  PLANNED
  COMPLETED
  CANCELLED
}

model Role {
  id Int @id @default(autoincrement())
  name RoleName @unique
  description String? @db.VarChar(255)
  users User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model User {
  id Int @id @default(autoincrement())
  email String @unique @db.VarChar(191)
  passwordHash String @db.VarChar(255)
  firstName String @db.VarChar(100)
  lastName String @db.VarChar(100)
  isActive Boolean @default(true)
  failedLoginAttempts Int @default(0)
  lockedUntil DateTime?
  teamId Int?
  team Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)
  managedTeam Team? @relation("ManagedTeam")
  roleId Int
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)
  ownedCustomers Customer[] @relation("CustomerOwner")
  assignedLeads Lead[] @relation("LeadAssignee")
  assignedOpportunities Opportunity[] @relation("OpportunityAssignee")
  assignedFollowUps FollowUp[] @relation("FollowUpAssignee")
  activities Activity[] @relation("ActivityUser")
  auditLogs AuditLog[]
  sessions Session[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@index([teamId])
}

model Team {
  id Int @id @default(autoincrement())
  name String @unique @db.VarChar(100)
  managerId Int? @unique
  manager User? @relation("ManagedTeam", fields: [managerId], references: [id], onDelete: SetNull)
  members User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id String @id @db.VarChar(128)
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  csrfSecret String @db.VarChar(128)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}
model Customer {
  id Int @id @default(autoincrement())
  code String @unique @db.VarChar(50)
  name String @db.VarChar(191)
  email String? @unique @db.VarChar(191)
  phone String? @unique @db.VarChar(30)
  company String? @db.VarChar(191)
  address String? @db.Text
  status CustomerStatus @default(PROSPECT)
  ownerId Int
  owner User @relation("CustomerOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  sourceLeadId Int? @unique
  sourceLead Lead? @relation("ConvertedLead", fields: [sourceLeadId], references: [id], onDelete: SetNull)
  opportunities Opportunity[]
  followUps FollowUp[]
  activities Activity[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([name])
}
model Lead {
  id Int @id @default(autoincrement())
  code String @unique @db.VarChar(50)
  name String @db.VarChar(191)
  email String? @db.VarChar(191)
  phone String? @db.VarChar(30)
  source String? @db.VarChar(100)
  status LeadStatus @default(NEW)
  expectedValue Decimal? @db.Decimal(15, 2)
  assigneeId Int?
  assignee User? @relation("LeadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  convertedCustomer Customer? @relation("ConvertedLead")
  opportunities Opportunity[]
  followUps FollowUp[]
  activities Activity[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assigneeId])
  @@index([status])
}
model Opportunity {
  id Int @id @default(autoincrement())
  code String @unique @db.VarChar(50)
  name String @db.VarChar(191)
  amount Decimal @db.Decimal(15, 2)
  stage OpportunityStage @default(PROSPECTING)
  probability Int @default(0)
  expectedCloseDate DateTime?
  leadId Int?
  lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customerId Int?
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assigneeId Int?
  assignee User? @relation("OpportunityAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  followUps FollowUp[]
  activities Activity[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([customerId])
  @@index([assigneeId])
  @@index([stage])
}
model FollowUp {
  id Int @id @default(autoincrement())
  dueDate DateTime
  type FollowUpType
  status FollowUpStatus @default(PLANNED)
  notes String? @db.Text
  assigneeId Int?
  assignee User? @relation("FollowUpAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  customerId Int?
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leadId Int?
  lead Lead? @relation(fields: [leadId], references: [id], onDelete: Cascade)
  opportunityId Int?
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dueDate])
  @@index([assigneeId])
  @@index([customerId])
  @@index([leadId])
  @@index([opportunityId])
}
model Activity {
  id Int @id @default(autoincrement())
  type ActivityType
  subject String @db.VarChar(255)
  occurredAt DateTime @default(now())
  status ActivityStatus @default(COMPLETED)
  details String? @db.Text
  userId Int
  user User @relation("ActivityUser", fields: [userId], references: [id], onDelete: Restrict)
  customerId Int?
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leadId Int?
  lead Lead? @relation(fields: [leadId], references: [id], onDelete: Cascade)
  opportunityId Int?
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([occurredAt])
  @@index([userId])
  @@index([customerId])
  @@index([leadId])
  @@index([opportunityId])
}
model AuditLog {
  id BigInt @id @default(autoincrement())
  userId Int?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  action String @db.VarChar(100)
  entity String @db.VarChar(100)
  recordId String @db.VarChar(100)
  oldValue Json?
  newValue Json?
  ipAddress String? @db.VarChar(45)
  createdAt DateTime @default(now())

  @@index([entity, recordId])
  @@index([userId])
  @@index([createdAt])
}
